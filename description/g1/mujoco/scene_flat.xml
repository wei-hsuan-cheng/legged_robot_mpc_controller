<mujoco model="g1_scene_flat">
  <!--
    Flat ground, no obstacles.

    scene.xml includes stairs.xml, whose first riser starts at x = 0.75 m. A
    forward walking test from the origin reaches it after only 0.75 m of travel -
    at 0.1 m/s, about 7 s of walking - so the swing foot stubs on a 0.10 m step
    and the robot stalls and topples. That failure is indistinguishable in a plot
    from a balance failure, and it silently confounds any locomotion tuning done
    on this scene.

    Use this scene for gait, balance and estimator tuning; use scene.xml when the
    stairs are the point.
  -->

  <!-- legged robot -->
  <include file="g1_29dof.xml"/>

  <!-- Match the legacy whole-body MuJoCo simulation timestep. -->
  <option timestep="0.0005"/>

  <statistic center="1.0 0.7 1.0" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb2="0.835 0.761 0.612" rgb1="0.639 0.722 0.8" width="512" height="512"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="random"
         rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
         markrgb="0.6 0.7 0.8"
         width="512" height="512"/>

    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          priority="1" friction="0.8 0.1 0.001"/>
  </worldbody>

</mujoco>
