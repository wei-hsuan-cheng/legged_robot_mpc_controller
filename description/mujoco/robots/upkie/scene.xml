<mujoco model="upkie_scene">
  <!-- sim rate: effort_pd runs every physics step; 2 kHz with the 1 kHz controller -->
  <option timestep="0.0005" />
  <!-- background: H2 night style, with lights aimed at Upkie's base -->
  <include file="../../common/backgrounds/background_night_upkie.xml" />
  <!-- terrain/object: optional; keep flat ground for the current wheel-drive checkpoint -->
  <!-- <include file="../../terrains/uneven_terrain.xml" /> -->
  <!-- <include file="../../terrains/ramp.xml" /> -->
  <!-- MuJoCo viewer (mujoco_ros2_control): follow the robot's centre of mass, T toggles; delete for the free camera.
       Optional: <text name="viewer_camera.body" data="base"/>, <numeric name="viewer_camera.track_distance" data="2.0"/> -->
  <custom>
    <text name="viewer_camera.mode" data="track" />
  </custom>
  <!-- robot -->
  <include file="upkie.xml" />
</mujoco>
