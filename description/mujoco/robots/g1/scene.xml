<mujoco model="g1_scene">
  <!-- sim rate -->
  <option timestep="0.0001" />
  <!-- background -->
  <include file="../../common/backgrounds/background_night.xml" />
  <!-- terrain/object -->
  <!-- <include file="../../terrains/uneven_terrain.xml" /> -->
  <!-- MuJoCo viewer (mujoco_ros2_control): follow the robot's centre of mass, T toggles; delete for the free camera.
       Optional: <text name="viewer_camera.body" data="pelvis"/>, <numeric name="viewer_camera.track_distance" data="2.0"/> -->
  <custom>
    <text name="viewer_camera.mode" data="track" />
    <numeric name="viewer_camera.track_distance" data="2.5" />
  </custom>
  <!-- robot -->
  <include file="g1_29dof.xml" />
</mujoco>
