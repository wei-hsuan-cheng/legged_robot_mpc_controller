<mujoco model="pineapple_course_scene">
  <!-- sim rate: effort_pd runs every physics step; 2 kHz with the 1 kHz controller -->
  <option timestep="0.0005" />
  <!-- background: H2 night style, with lights aimed at Pineapple's base_link -->
  <include file="../../common/backgrounds/background_night_pineapple.xml" />
  <!-- terrain: the Upkie test course (uneven field, ramps, steps, one-wheel ramp), robot spawned on its flat start -->
  <include file="../../terrains/upkie_course.xml" />
  <!-- robot -->
  <include file="pineapple.xml" />
</mujoco>
