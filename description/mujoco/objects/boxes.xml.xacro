<?xml version="1.0"?>
<mujoco model="boxes" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Parametric movable boxes for MuJoCo.

    Generate the xml file using xacro with the following command:
      xacro \
        ./boxes.xml.xacro \
        boxes_params_file:=../../../config/objects/boxes_params.yaml \
        -o ./boxes.xml

    Each box is a free body at its world centre position and yaw, with full edge
    lengths, mass, principal inertia and colour taken from the params file.
  -->
  <xacro:arg name="boxes_params_file" default="../../../config/objects/boxes_params.yaml"/>
  <xacro:property name="boxes_params_file" value="$(arg boxes_params_file)"/>

  <xacro:property name="boxes" value="${xacro.load_yaml(boxes_params_file)['boxes']}"/>

  <xacro:property name="box_ids" value="${list(boxes.keys())}"/>

  <!--
    Recursively emit one free body per box.
      i : zero-based entry index; every attribute belongs to that entry
  -->
  <xacro:macro name="emit_box" params="i">
    <xacro:if value="${i &lt; len(box_ids)}">
      <xacro:property name="box" value="${boxes[box_ids[i]]}"/>
      <xacro:property name="name" value="${box.get('name', box_ids[i])}"/>
      <xacro:property name="p"   value="${box['position']}"/>
      <xacro:property name="s"   value="${box['size']}"/>
      <xacro:property name="I"   value="${box['inertia']}"/>
      <xacro:property name="c"   value="${box['color']}"/>
      <xacro:property name="yaw" value="${box['yaw']}"/>
      <xacro:property name="friction" value="${box['friction']}"/>

      <body name="${name}" pos="${p[0]} ${p[1]} ${p[2]}" quat="${cos(yaw / 2.0)} 0 0 ${sin(yaw / 2.0)}">
        <freejoint/>
        <geom type="box"
              size="${s[0] / 2.0} ${s[1] / 2.0} ${s[2] / 2.0}"
              material="studio_terrain" rgba="${c[0]} ${c[1]} ${c[2]} ${c[3]}"
              friction="${friction[0]} ${friction[1]} ${friction[2]}"/>
        <inertial pos="0 0 0" mass="${box['mass']}" diaginertia="${I[0]} ${I[1]} ${I[2]}"/>
      </body>

      <xacro:emit_box i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <worldbody>
    <xacro:emit_box i="${0}"/>
  </worldbody>
</mujoco>
