<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="h2_ros2_control_macros">
  <xacro:macro name="h2_joint_ros2_control" params="       joint_name       use_mujoco_sim       joint_init       command_interface:=effort       effort_limit:=100.0       effort_pd_kp:=1200.0       effort_pd_kd:=10.0       mujoco_position_kp:=10000       mujoco_position_ki:=50       mujoco_position_kd:=500       mujoco_position_i_max:=10000       mujoco_position_i_min:=-10000">
    <joint name="${joint_name}">
      <xacro:if value="${command_interface == 'effort_pd'}">
        <param name="effort_pd">true</param>
        <param name="effort_pd_kp">${effort_pd_kp}</param>
        <param name="effort_pd_kd">${effort_pd_kd}</param>
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort">
          <param name="min">${-effort_limit}</param>
          <param name="max">${effort_limit}</param>
        </command_interface>
        <command_interface name="kp" />
        <command_interface name="kd" />
      </xacro:if>
      <xacro:if value="${command_interface == 'effort'}">
        <command_interface name="effort">
          <param name="min">${-effort_limit}</param>
          <param name="max">${effort_limit}</param>
        </command_interface>
      </xacro:if>
      <xacro:unless value="${command_interface == 'effort' or command_interface == 'effort_pd'}">
        <xacro:if value="${use_mujoco_sim}">
          <param name="position_kp">${mujoco_position_kp}</param>
          <param name="position_ki">${mujoco_position_ki}</param>
          <param name="position_kd">${mujoco_position_kd}</param>
          <param name="position_i_max">${mujoco_position_i_max}</param>
          <param name="position_i_min">${mujoco_position_i_min}</param>
          <command_interface name="position_pid" />
        </xacro:if>
        <xacro:unless value="${use_mujoco_sim}">
          <command_interface name="position" />
        </xacro:unless>
      </xacro:unless>
      <state_interface name="position">
        <param name="initial_value">${joint_init[joint_name]}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort" />
    </joint>
  </xacro:macro>
  <xacro:macro name="foot_contact_sensor" params="name body threshold:=5.0">
    <sensor name="${name}">
      <param name="mujoco_contact_body_name">${body}</param>
      <param name="mujoco_contact_frame">body</param>
      <param name="mujoco_contact_threshold">${threshold}</param>
      <state_interface name="force.x" />
      <state_interface name="force.y" />
      <state_interface name="force.z" />
      <state_interface name="torque.x" />
      <state_interface name="torque.y" />
      <state_interface name="torque.z" />
      <state_interface name="normal_force" />
      <state_interface name="contact" />
    </sensor>
  </xacro:macro>
  
  <xacro:macro name="h2_ros2_control" params="       use_fake_hardware       use_mujoco_sim       joint_init       system_name:=H2System       command_interface:=effort       effort_pd_kp:=1200.0       effort_pd_kd:=10.0       mujoco_position_kp:=10000       mujoco_position_ki:=50       mujoco_position_kd:=500       mujoco_position_i_max:=10000       mujoco_position_i_min:=-10000       mujoco_effort_command_mode:=actuator       use_lidar:=false       use_contact_sensors:=true       base_height:=''">
    <ros2_control name="${system_name}" type="system">
      <hardware>
        <xacro:if value="${use_mujoco_sim}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
          <param name="mujoco_effort_command_mode">${mujoco_effort_command_mode}</param>
          <xacro:if value="${base_height != ''}">
            <param name="initial_base_height">${base_height}</param>
          </xacro:if>
        </xacro:if>
        <xacro:unless value="${use_mujoco_sim}">
          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">false</param>
            <param name="calculate_dynamics">true</param>
            <param name="position_state_following_offset">0.0</param>
          </xacro:if>
        </xacro:unless>
      </hardware>
      <xacro:if value="${use_mujoco_sim}">
        <sensor name="pelvis">
          <param name="mujoco_body_name">pelvis</param>
          <state_interface name="position.x" />
          <state_interface name="position.y" />
          <state_interface name="position.z" />
          <state_interface name="orientation.w" />
          <state_interface name="orientation.x" />
          <state_interface name="orientation.y" />
          <state_interface name="orientation.z" />
          <state_interface name="linear_velocity.x" />
          <state_interface name="linear_velocity.y" />
          <state_interface name="linear_velocity.z" />
          <state_interface name="angular_velocity.x" />
          <state_interface name="angular_velocity.y" />
          <state_interface name="angular_velocity.z" />
        </sensor>
        <sensor name="pelvis_imu">
          <param name="mujoco_quat_sensor_name">imu_quat</param>
          <param name="mujoco_gyro_sensor_name">imu_gyro</param>
          <param name="mujoco_accel_sensor_name">imu_acc</param>
          <state_interface name="orientation.w" />
          <state_interface name="orientation.x" />
          <state_interface name="orientation.y" />
          <state_interface name="orientation.z" />
          <state_interface name="angular_velocity.x" />
          <state_interface name="angular_velocity.y" />
          <state_interface name="angular_velocity.z" />
          <state_interface name="linear_acceleration.x" />
          <state_interface name="linear_acceleration.y" />
          <state_interface name="linear_acceleration.z" />
        </sensor>
        <!-- Simulation-only ground truth: net contact wrench on each foot body (body frame, about
             the body origin, so -torque.y / force.z is the centre of pressure along the sole), its
             summed normal force and a contact flag above the threshold [N]. -->
        <xacro:if value="${use_contact_sensors}">
          <xacro:foot_contact_sensor name="left_foot_contact" body="left_ankle_pitch_link" />
          <xacro:foot_contact_sensor name="right_foot_contact" body="right_ankle_pitch_link" />
        </xacro:if>
        <xacro:if value="${use_lidar}">
          <sensor name="mid360_lidar">
            <param name="mujoco_site_name">mid360</param>
            <param name="scan_pattern">mid360</param>
            <param name="frame_id">mid360_link</param>
            <param name="topic">/livox/lidar</param>
            <state_interface name="frame_count" />
            <state_interface name="stamp" />
            <state_interface name="num_points" />
            <state_interface name="min_range" />
          </sensor>
        </xacro:if>
      </xacro:if>
      <xacro:h2_joint_ros2_control joint_name="left_hip_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_hip_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_hip_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_knee_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_ankle_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="19" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_ankle_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="66.88" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_hip_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_hip_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_hip_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_knee_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="360" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_ankle_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="19" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_ankle_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="66.88" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="waist_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="120" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="waist_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="180" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="waist_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="180" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="head_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="50" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="head_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="50" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_shoulder_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="130" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_shoulder_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_shoulder_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_elbow_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_wrist_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_wrist_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="10" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="left_wrist_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="10" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_shoulder_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="130" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_shoulder_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_shoulder_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_elbow_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_wrist_roll_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="60" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_wrist_pitch_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="10" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
      <xacro:h2_joint_ros2_control joint_name="right_wrist_yaw_joint" use_mujoco_sim="${use_mujoco_sim}" joint_init="${joint_init}" command_interface="${command_interface}" effort_pd_kp="${effort_pd_kp}" effort_pd_kd="${effort_pd_kd}" effort_limit="10" mujoco_position_kp="${mujoco_position_kp}" mujoco_position_ki="${mujoco_position_ki}" mujoco_position_kd="${mujoco_position_kd}" mujoco_position_i_max="${mujoco_position_i_max}" mujoco_position_i_min="${mujoco_position_i_min}" />
    </ros2_control>
  </xacro:macro>
</robot>
