<?xml version="1.0"?>
<robot name="environment" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    RViz environment, the counterpart of the terrain/object includes in the MuJoCo
    scene (../mujoco/robots/<robot>/scene.xml). robot.launch.py always publishes this
    file as /environment/robot_description. Comment or uncomment the pieces to match
    the scene; each include attaches its links to the "world" link below and reads
    its own params file under config/, the same one its MuJoCo module uses.
  -->
  <link name="world"/>

  <!-- terrain/object -->
  <!-- <xacro:include filename="terrains/stairs.urdf.xacro"/> -->
  <xacro:include filename="terrains/uneven_terrain.urdf.xacro"/>
  <xacro:include filename="terrains/ramp.urdf.xacro"/>
  <!-- <xacro:include filename="objects/boxes.urdf.xacro"/> -->
</robot>
