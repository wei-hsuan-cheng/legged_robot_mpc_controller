<?xml version="1.0"?>
<robot name="boxes" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Environment description: the parametric boxes (same convention as
    ../../mujoco/objects/boxes.xml.xacro, driven by the SAME params file). It is not
    part of the robot. robot.launch.py runs it through xacro when selected with
    environmentDescription and publishes it with its own robot_state_publisher in
    the "environment" namespace.

    The boxes are free bodies in the simulator, so this shows their SPAWN pose:
      <parent> -[fixed]-> <name of box 1> ... <name of box N>
  -->
  <xacro:arg name="boxes_params_file" default="../../../config/objects/boxes_params.yaml"/>
  <xacro:arg name="parent" default="world"/>

  <xacro:property name="boxes_params_file" value="$(arg boxes_params_file)"/>
  <xacro:property name="parent_link"       value="$(arg parent)"/>

  <xacro:property name="boxes" value="${xacro.load_yaml(boxes_params_file)['boxes']}"/>

  <xacro:property name="box_ids" value="${list(boxes.keys())}"/>

  <link name="${parent_link}"/>

  <!--
    Recursively emit one link + fixed joint per box.
      i : zero-based entry index
  -->
  <xacro:macro name="emit_box" params="i">
    <xacro:if value="${i &lt; len(box_ids)}">
      <xacro:property name="box" value="${boxes[box_ids[i]]}"/>
      <xacro:property name="name" value="${box.get('name', box_ids[i])}"/>
      <xacro:property name="p" value="${box['position']}"/>
      <xacro:property name="s" value="${box['size']}"/>
      <xacro:property name="c" value="${box['color']}"/>

      <link name="${name}">
        <visual>
          <geometry>
            <box size="${s[0]} ${s[1]} ${s[2]}"/>
          </geometry>
          <material name="${name}_mat">
            <color rgba="${c[0]} ${c[1]} ${c[2]} ${c[3]}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <box size="${s[0]} ${s[1]} ${s[2]}"/>
          </geometry>
        </collision>
      </link>
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent_link}"/>
        <child link="${name}"/>
        <origin xyz="${p[0]} ${p[1]} ${p[2]}" rpy="0 0 ${box['yaw']}"/>
      </joint>

      <xacro:emit_box i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:emit_box i="${0}"/>
</robot>
